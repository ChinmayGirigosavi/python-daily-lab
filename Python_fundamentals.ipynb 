        "id": "d4XKasavDBbe"
      },
      "source": [
        "7. [***Membership Operator***](https://www.geeksforgeeks.org/python/python-membership-identity-operators-not-not/)\n",
        "\n",
        "* 'in' is a membership operator in Python.\n",
        "* It is used to test whether a value or an element exists within a sequence or a collection (such as a string, list, tuple, set, or dictionary)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f46226FZ8NXS",
        "outputId": "ee513b91-85b3-4996-8810-36ddc014217b"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "True\n",
            "False\n",
            "True \n",
            "\n",
            "True\n",
            "True\n",
            "False \n",
            "\n",
            "True\n",
            "False\n"
          ]
        }
      ],
      "source": [
        "# in and not in are the membership operators\n",
        "rollno_list = [23,24, 25, 26, 28]\n",
        "subject = \"Foundation of Data Science\"\n",
        "dictionary = {1: \"Foundation\", 2: \"of\", 3: \"Data Science\"}\n",
        "\n",
        "print(28 in rollno_list)\n",
        "print(30 in rollno_list)\n",
        "# returns Flase because the element 30 does not exists inside the given sequence (rollno_list)\n",
        "\n",
        "print(30 not in rollno_list, \"\\n\")\n",
        "# 'not in' operator confirms that the element 30 does not exists in rollno_list (given sequence)\n",
        "\n",
        "\n",
        "print(\"Foundation\" in subject)\n",
        "print(\"of\" in subject)\n",
        "print(\"Of\" in subject, \"\\n\")\n",
        "# returns False because Python is case sensitive ('of' does not equal 'Of')\n",
        "\n",
        "print(2 in dictionary)\n",
        "print(\"Foundation\" in dictionary)\n",
        "# False because dictionary membership checks keys, not values."
      ]
    },
